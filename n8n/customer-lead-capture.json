      "typeVersion": 1.4,
      "position": [
        520,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ...$json, n8n_execution_id: $execution.id }) }}",
        "options": {}
      }
    }
  ],
  "connections": {
