        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 35000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "flowmeetCaptureApiKey",
          "name": "FlowMeet customer workspace API key"
        }
      }
